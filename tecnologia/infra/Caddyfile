{
  auto_https off
  admin off
  log {
    exclude http.log.error
  }
}
https://localhost:8443 {
  tls /certs/localhost.crt /certs/localhost.key
  header {
    >Cache-Control no-store
    >Referrer-Policy no-referrer
    >X-Content-Type-Options nosniff
  }
  request_body {
    max_size 14000000
  }
  handle /api/v1/* {
    reverse_proxy host.docker.internal:3000
  }
  handle {
    reverse_proxy host.docker.internal:5173
  }
  handle_errors {
    header {
      >Cache-Control no-store
      >Referrer-Policy no-referrer
      >X-Content-Type-Options nosniff
    }
    @limite expression {err.status_code} == 413
    handle @limite {
      header Content-Type application/json
      respond `{"codigo":"CUERPO_DEMASIADO_GRANDE","mensaje":"El cuerpo supera el límite permitido.","detalles":[]}` 413
    }
    handle {
      header Content-Type application/json
      respond `{"codigo":"DEPENDENCIA_NO_DISPONIBLE","mensaje":"Servicio temporalmente no disponible.","detalles":[]}` 503
    }
  }
}
