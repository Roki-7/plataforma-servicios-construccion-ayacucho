{
  "name": "@ayacucho/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/composicion/main.js",
    "start:validation": "tsx scripts/iniciar-validacion.ts",
    "start:validation:002": "tsx scripts/iniciar-validacion-002.ts iniciar",
    "dev:prepare:002": "tsx scripts/preparar-validacion-002.ts",
    "db:migrate:002": "tsx scripts/iniciar-validacion-002.ts migrar",
    "storage:init:002": "tsx scripts/iniciar-validacion-002.ts storage",
    "test:https:002": "tsx scripts/verificar-https-002.ts",
    "backup:portafolio:002": "tsx scripts/respaldar-portafolio-002.ts",
    "restore:portafolio:002": "tsx scripts/restaurar-portafolio-002.ts",
    "test:seed:002": "tsx scripts/iniciar-validacion-002.ts seed",
    "start:validation:003": "tsx scripts/iniciar-validacion-003.ts iniciar",
    "dev:prepare:003": "tsx scripts/preparar-validacion-003.ts",
    "db:migrate:003": "tsx scripts/iniciar-validacion-003.ts migrar",
    "storage:init:003": "tsx scripts/iniciar-validacion-003.ts storage",
    "test:seed:003": "tsx scripts/iniciar-validacion-003.ts seed",
    "dev:prepare": "tsx scripts/preparar-validacion.ts",
    "db:migrate": "tsx scripts/migrar.ts",
    "storage:init": "tsx scripts/inicializar-storage.ts",
    "security:catalog:prepare": "tsx scripts/preparar-catalogo.ts",
    "test:seed": "tsx test/soporte/fixtures.ts",
    "test:container": "tsx scripts/verificar-contenedor.ts",
    "test:proxy": "tsx scripts/verificar-proxy.ts",
    "test:performance": "k6 run test/performance/usuarios-acceso.k6.js",
    "test:argon2:coste": "tsx scripts/medir-argon2.ts",
    "test:salud": "tsx scripts/observar-salud.ts",
    "test:respaldo": "tsx scripts/ensayar-recuperacion.ts",
    "test:unit": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --selectProjects unit --runInBand",
    "test:integration": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --selectProjects integration",
    "test:integration:002": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --selectProjects integration --maxWorkers=2 --testPathPatterns prestadores-catalogo --testPathIgnorePatterns \"redis-revision|procedimiento-rf39-aislado|restauracion-portafolio|fotos-cuenta-composicion\"",
    "test:integration:002:infra": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --selectProjects integration --runInBand --testPathPatterns \"redis-revision|procedimiento-rf39-aislado|restauracion-portafolio|fotos-cuenta-composicion\"",
    "test:contract": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --selectProjects contract --runInBand",
    "test:integration:003": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --selectProjects integration --maxWorkers=2 --testPathPatterns solicitudes-cotizaciones",
    "test:architecture": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --selectProjects architecture --runInBand",
    "test:coverage:001": "tsx scripts/verificar-cobertura-001.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1169.0",
    "@nestjs/common": "12.5.0",
    "@nestjs/core": "12.5.0",
    "@nestjs/platform-express": "12.5.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "argon2": "0.45.2",
    "dotenv": "17.4.2",
    "express": "5.3.0",
    "nodemailer": "7.0.13",
    "pg": "8.23.1",
    "redis": "5.12.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.34.5",
    "typeorm": "0.3.31"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@jest/globals": "30.5.2",
    "@nestjs/testing": "12.5.0",
    "@swc/core": "1.16.22",
    "@swc/jest": "0.2.39",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@types/nodemailer": "7.0.12",
    "@types/pg": "8.23.1",
    "@types/supertest": "6.0.3",
    "cross-env": "10.1.0",
    "dependency-cruiser": "18.7.2",
    "eslint": "9.39.5",
    "globals": "16.5.0",
    "jest": "30.5.2",
    "jest-junit": "16.0.0",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  }
}
