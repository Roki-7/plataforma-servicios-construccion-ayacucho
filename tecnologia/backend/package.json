{
  "name": "@ayacucho/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/composicion/main.js",
    "start:validation": "tsx scripts/iniciar-validacion.ts",
    "dev:prepare": "tsx scripts/preparar-validacion.ts",
    "db:migrate": "tsx scripts/migrar.ts",
    "storage:init": "tsx scripts/inicializar-storage.ts",
    "security:catalog:prepare": "tsx scripts/preparar-catalogo.ts",
    "test:seed": "tsx test/soporte/fixtures.ts",
    "test:container": "tsx scripts/verificar-contenedor.ts",
    "test:proxy": "tsx scripts/verificar-proxy.ts",
    "test:unit": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --selectProjects unit --runInBand",
    "test:integration": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --selectProjects integration",
    "test:contract": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --selectProjects contract --runInBand",
    "test:architecture": "depcruise --config ../dependency-cruiser.cjs src ../frontend/src",
    "test:coverage:001": "node scripts/cobertura-pendiente.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1169.0",
    "@nestjs/common": "12.5.0",
    "@nestjs/core": "12.5.0",
    "@nestjs/platform-express": "12.5.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "argon2": "0.45.2",
    "dotenv": "17.4.2",
    "express": "5.3.0",
    "nodemailer": "7.0.13",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.34.5",
    "typeorm": "0.3.31"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@jest/globals": "30.5.2",
    "@nestjs/testing": "12.5.0",
    "@swc/core": "1.16.22",
    "@swc/jest": "0.2.39",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@types/nodemailer": "7.0.12",
    "@types/pg": "8.23.1",
    "@types/supertest": "6.0.3",
    "cross-env": "10.1.0",
    "dependency-cruiser": "18.7.2",
    "eslint": "9.39.5",
    "globals": "16.5.0",
    "jest": "30.5.2",
    "jest-junit": "16.0.0",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  }
}
