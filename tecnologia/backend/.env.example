# Configuración del servidor; los valores privados se generan con dev:prepare.
NODE_ENV=production
VALIDATION_MODE=false
PORT=3000
PUBLIC_ORIGIN=https://localhost:8443
PUBLIC_URL=https://localhost:8443
DATABASE_URL=postgresql://usuario:CAMBIAR@localhost:54329/ayacucho
CATALOGO_MANIFIESTO=/config/catalogo/manifest.json
HMAC_KEY_ID=v1
HMAC_KEYS_JSON={"v1":"REEMPLAZAR_POR_32_BYTES_BASE64"}
AEAD_KEY_ID=v1
AEAD_KEYS_JSON={"v1":"REEMPLAZAR_POR_32_BYTES_BASE64"}
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=seguridad@example.invalid
S3_ENDPOINT=http://127.0.0.1:3900
S3_REGION=garage
S3_BUCKET=usuarios-validacion
S3_ACCESS_KEY_ID=CAMBIAR
S3_SECRET_ACCESS_KEY=CAMBIAR
