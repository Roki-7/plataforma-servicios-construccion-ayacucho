{
  "compilerOptions": {
    "target": "ES2024", "lib": ["ES2024"], "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true,
    "experimentalDecorators": true, "emitDecoratorMetadata": true, "esModuleInterop": true,
    "verbatimModuleSyntax": true, "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true, "rootDir": ".", "outDir": "dist", "sourceMap": true,
    "types": ["node", "jest"]
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts", "test/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
